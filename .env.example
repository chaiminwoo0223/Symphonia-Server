# local 프로파일로 bootRun, jar, importCatalog를 실행할 때 필요한 변수다. 이 파일을 .env로 복사해 값을 채운다.
# 값은 커밋하지 않는다. dev, prod 전용 변수(DB_*, REDIS_*, RABBITMQ_HOST, RABBITMQ_PORT, GATHERING_LINK_BASE_URL)는 배포 환경에서 주입한다.
# 기본값이 있는 변수(ACCESS_TOKEN_EXPIRATION_TIME, CORS_ALLOWED_ORIGINS 등)는 바꿀 때만 추가한다.

# compose.yaml의 PostgreSQL과 앱의 datasource가 함께 쓴다.
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=

# compose.yaml의 RabbitMQ와 앱이 함께 쓴다. 브로커 계정은 볼륨을 처음 만들 때만 적용되므로, 바꾸면 rabbitmq 컨테이너와 볼륨을 다시 만든다.
RABBITMQ_USERNAME=
RABBITMQ_PASSWORD=

# 모임 개인정보 암호화 키다. base64로 인코딩한 256비트 값이다(openssl rand -base64 32).
GATHERING_MASTER_KEY=

# 액세스 토큰 서명 키다.
JWT_SECRET=

KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
KAKAO_REDIRECT_URI=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
